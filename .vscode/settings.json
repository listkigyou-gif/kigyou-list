{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/*.db": true,
    "**/*.db-shm": true,
    "**/*.db-wal": true,
    "**/*.sqlite": true,
    "**/*.csv": true,
    "**/*.log*": true,
    "**/*.tmp": true,
    "**/*.tar.gz": true,
    "**/*.zip": true,
    "**/__pycache__": true,
    "importdata/**": true,
    "frontend/.next/**": true,
    "crawlers/**/data/**": true,
    "crawlers/**/logs/**": true,
    "crawlers/hellowork/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/*.db": true,
    "**/*.db-shm": true,
    "**/*.db-wal": true,
    "**/*.sqlite": true,
    "**/*.csv": true,
    "**/*.log*": true,
    "**/*.tmp": true,
    "**/*.tar.gz": true,
    "**/*.zip": true,
    "**/__pycache__": true,
    "importdata/**": true,
    "scratch/**": true,
    "frontend/.next/**": true,
    "crawlers/**/data/**": true,
    "crawlers/**/logs/**": true,
    "crawlers/hellowork/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/*.db": true,
    "**/*.db-shm": true,
    "**/*.db-wal": true,
    "**/*.sqlite": true,
    "**/*.csv": true,
    "**/*.log*": true,
    "**/*.tmp": true,
    "**/*.tar.gz": true,
    "**/*.zip": true,
    "**/__pycache__/**": true,
    "importdata/**": true,
    "scratch/**": true,
    "frontend/.next/**": true,
    "crawlers/**/data/**": true,
    "crawlers/**/logs/**": true,
    "crawlers/hellowork/**": true
  }
}
